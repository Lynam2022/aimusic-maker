generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



// ── User ─────────────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String
  name         String?
  avatarUrl    String?
  credits      Int      @default(20)
  totalEarned  Int      @default(20)   // lifetime credits earned
  totalSpent   Int      @default(0)    // lifetime credits spent
  isActive     Boolean  @default(true)
  role         String   @default("user")
  sunoCookie   String?  @db.Text
  sunoCookieEmail  String?            // email của tài khoản Suno (để hiển thị)
  sunoCookieExpiresAt DateTime?       // thời điểm cookie hết hạn
  sunoBrowserToken String?  @db.Text  // browser-token từ Suno frontend (Kasada)
  storagePath  String?  @db.Text  // custom storage path/bucket for this user's songs
  storageLimit Int      @default(999999) // max songs this user can generate/store
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  songs        Song[]
  transactions Transaction[]

  @@map("users")
}

// ── Song (generation record) ──────────────────────────────────
model Song {
  id          String   @id @default(cuid())
  userId      String
  prompt      String?  @db.Text
  lyrics      String?  @db.Text
  mode        String   @default("describe")  // describe | lyrics
  outputType  String   @default("vocal")     // vocal | instrumental
  vocalGender String   @default("auto")      // auto | female | male
  musicStyle  String?
  songTitle   String?
  status      String   @default("queued")    // queued | processing | completed | failed
  taskId      String?  @unique
  tracks      Json     @default("[]")
  creditsCost Int      @default(10)
  errorMsg    String?
  sunoModel   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([taskId])
  @@index([status])
  @@map("songs")
}

// ── Transaction ledger ────────────────────────────────────────
model Transaction {
  id        String   @id @default(cuid())
  userId    String
  type      String   // deposit | debit | refund
  amount    Int      // credits (always positive)
  balance   Int      // balance AFTER this transaction
  note      String?
  vndAmount Int?     // VNĐ amount for deposits (10,000 VNĐ = 10 credits)
  songId    String?  // linked song for debit/refund
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("transactions")
}

// ── System Config ─────────────────────────────────────────────
model SystemConfig {
  key   String @id
  value String @db.Text

  @@map("system_configs")
}
